{
  "name": "wp-release-helper",
  "version": "0.1.0",
  "description": "Generate release-post change summaries for WordPress Core & Gutenberg from GitHub (+ Trac via MCP).",
  "type": "module",
  "bin": {
    "uwp": "bin/wp-release-helper.mjs",
    "wp-release-helper": "bin/wp-release-helper.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/wp-release-helper.mjs",
    "build": "webpack --mode production",
