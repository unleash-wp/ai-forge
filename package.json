{
  "name": "@unleashwp/ai-forge",
  "version": "0.3.0",
  "author": "UnleashWP (https://unleash-wp.com)",
  "description": "UnleashWP AI Forge — a hub for WordPress release tooling. Runs a browser UI, a zero-dependency CLI, and an MCP server (`uwp mcp`) so Claude Code and Codex can query its tools and skills live.",
  "type": "module",
  "bin": {
    "uwp-ai-forge": "bin/ai-forge.mjs",
    "uwp": "bin/ai-forge.mjs",
    "ai-forge": "bin/ai-forge.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "plugins",
    "languages",
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/ai-forge.mjs",
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "new-tool": "node scripts/new-tool.mjs",
    "mcpb:pack": "node scripts/sync-version.mjs && npm run build && npx -y @anthropic-ai/mcpb pack . unleashwp-ai-forge.mcpb",
    "wiki:publish": "bash scripts/publish-wiki.sh",
    "version": "node scripts/sync-version.mjs",
    "test": "node --test",
    "prepare": "webpack --mode production",
    "prepublishOnly": "npm run build && node --test"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@chakra-ui/charts": "^3.36.1",
    "@chakra-ui/react": "^3.36.1",
    "@emotion/react": "^11.14.0",
    "@remixicon/react": "^4.9.0",
    "babel-loader": "^10.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unleash-wp/ai-forge"
  },
  "license": "GPL-2.0-or-later"
}
