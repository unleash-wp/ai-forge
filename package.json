{
  "name": "wp-release-helper",
  "version": "0.1.0",
  "description": "Generate release-post change summaries for WordPress Core & Gutenberg from GitHub (+ Trac via MCP).",
  "type": "module",
  "bin": {
    "uwp": "bin/wp-release-helper.mjs",
    "wp-release-helper": "bin/wp-release-helper.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/wp-release-helper.mjs",
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "test": "node --test",
    "prepare": "webpack --mode production"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
